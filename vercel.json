{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/download",
      "destination": "/RAIWAVE.apk"
    },
    {
      "source": "/apk",
      "destination": "/RAIWAVE.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/RAIWAVE.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"RAIWAVE.apk\""
        }
      ]
    }
  ]
}
